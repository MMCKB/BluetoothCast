<Window
    x:Class="BtAudioSink.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BtAudioSink.Models"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      FontFamily="Segoe MDL2 Assets"
                      Glyph="&#xE702;"
                      FontSize="16" Margin="16,0,12,0"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Text="投音通"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,4,16,24">
            <StackPanel MaxWidth="680" Spacing="12">

                <!-- 状态概览 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="HeroBadge"
                                Width="64" Height="64" CornerRadius="32"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE702;"
                                      FontSize="30"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="White" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="HeroTitle"
                                       FontSize="20" FontWeight="SemiBold"
                                       Text="等待连接" />
                            <TextBlock x:Name="HeroSubtitle"
                                       Style="{StaticResource CardHintStyle}"
                                       Text="在下方选择一个已配对的蓝牙设备" />
                        </StackPanel>

                        <Button x:Name="RefreshButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Content="刷新设备"
                                Click="OnRefreshClick" />
                    </Grid>
                </Border>

                <InfoBar x:Name="NoticeBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

                <!-- 设备列表 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <TextBlock Margin="16,14,16,4"
                                   Style="{StaticResource CardTitleStyle}"
                                   Text="可用音源设备" />
                        <TextBlock Margin="16,0,16,8"
                                   Style="{StaticResource CardHintStyle}"
                                   Text="点击一个设备进行连接或断开" />

                        <ListView x:Name="DeviceList"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ItemClick="OnDeviceItemClick"
                                  MaxHeight="288"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       Text="{Binding Initial}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="14" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{Binding StatusBrush}"
                                                       Text="{Binding StatusText}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Width="8" Height="8" CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{Binding StatusBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="EmptyHint"
                                   Margin="16,4,16,16"
                                   Style="{StaticResource CardHintStyle}"
                                   Text="还没有找到可用设备。请先在 Windows 设置中完成蓝牙配对。"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 声音输出 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="声音输出" />
                        <TextBlock x:Name="DefaultOutputText"
                                   Style="{StaticResource CardHintStyle}"
                                   Text="当前默认输出：读取中…" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="OutputCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnOutputSelectionChanged" />
                            <Button Grid.Column="1"
                                    Content="系统声音设置"
                                    Click="OnSoundSettingsClick" />
                        </Grid>

                        <InfoBar x:Name="OutputWarningBar"
                                 Margin="0,4,0,0"
                                 IsOpen="False"
                                 IsClosable="True"
                                 Severity="Warning" />
                    </StackPanel>
                </Border>

                <!-- 设置（折叠，默认收起以精简主界面） -->
                <Expander Header="设置"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="2" Margin="0,4,0,0">

                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" />
                                <TextBlock Style="{StaticResource CardHintStyle}" Text="登录后静默运行到托盘" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" Toggled="OnStartupToggled" />
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动重连上次设备" />
                                <TextBlock Style="{StaticResource CardHintStyle}" Text="启动时自动连接上次使用的音源" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoReconnectSwitch" Grid.Column="1" Toggled="OnAutoReconnectToggled" />
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启动时最小化" />
                                <TextBlock Style="{StaticResource CardHintStyle}" Text="开机自启时不弹出主窗口" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedSwitch" Grid.Column="1" Toggled="OnStartMinimizedToggled" />
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="关闭时隐藏到托盘" />
                                <TextBlock Style="{StaticResource CardHintStyle}" Text="关闭窗口后继续在后台接收音频" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CloseToTraySwitch" Grid.Column="1" Toggled="OnCloseToTrayToggled" />
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="连接状态通知" />
                                <TextBlock Style="{StaticResource CardHintStyle}" Text="状态变化时弹出系统通知" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotifySwitch" Grid.Column="1" Toggled="OnNotifyToggled" />
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="连接方式" />
                                <TextBlock Style="{StaticResource CardHintStyle}"
                                           Text="「显示已连接但没声音」时，改成仅监听、由手机发起" />
                            </StackPanel>
                            <ComboBox x:Name="ConnectModeCombo" Grid.Column="1" MinWidth="160"
                                      SelectionChanged="OnConnectModeChanged">
                                <ComboBoxItem Content="主动连接（推荐）" Tag="0" />
                                <ComboBoxItem Content="仅监听，由手机发起" Tag="1" />
                            </ComboBox>
                        </Grid>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
